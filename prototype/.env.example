# version: 0.1.0
# tags: [prototype, config, env, llm]

# Copy to .env (never commit .env) and fill in LLM_API_KEY.
# Any OpenAI-compatible endpoint works; switching providers only changes these values.

# Gemini free tier (key from https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Ollama fallback (no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<a model you have pulled>
